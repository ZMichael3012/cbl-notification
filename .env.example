# Local environment variables for cbl-notification.
HTTP_ADDR=:8090
GRPC_ADDR=:9090
METRICS_ADDR=:9290
PG_DSN=postgres://cbl:cbl@localhost:5432/notification?sslmode=disable
MIGRATIONS_DIR=./migrations
KAFKA_BROKERS=localhost:9092
# AES-256 key of the signing secret encryption: 64 hex characters.
# Generate with: openssl rand -hex 32 (never commit the real value).
NOTIFICATION_SECRET_KEY=
